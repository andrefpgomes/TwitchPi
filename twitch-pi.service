[Unit]
Description=TwitchPi Web Controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/twitch-pi
Environment=PORT=8765
Environment=STATE_FILE=/opt/twitch-pi/state.json
Environment=TWITCH_PROFILE=/root/.config/twitch-pi-chromium
ExecStart=/usr/bin/python3 /opt/twitch-pi/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
